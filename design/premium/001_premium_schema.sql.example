-- Kinaraidee Premium backend schema DRAFT
-- STATUS: DESIGN ONLY / DO NOT APPLY TO PRODUCTION
-- This file intentionally lives under design/ and uses .example so it is not an executable migration.
-- Provider, merchant, price, legal campaign mechanics and production rollout are NOT APPROVED.

begin;

create table if not exists public.premium_provider_customers (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references auth.users(id) on delete cascade,
  provider text not null,
  provider_customer_ref text not null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (provider, provider_customer_ref),
  unique (user_id, provider)
);

create table if not exists public.premium_subscriptions (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references auth.users(id) on delete cascade,
  provider text not null,
  provider_subscription_ref text not null,
  provider_customer_ref text,
  plan_code text not null,
  currency text not null default 'THB',
  amount_minor integer not null check (amount_minor >= 0),
  status text not null check (status in (
    'incomplete','trialing','active','past_due','grace','cancel_at_period_end',
    'canceled','unpaid','refunded','disputed','revoked'
  )),
  current_period_start timestamptz,
  current_period_end timestamptz,
  cancel_at_period_end boolean not null default false,
  canceled_at timestamptz,
  last_provider_event_at timestamptz,
  last_provider_event_ref text,
  is_test boolean not null default true,
  metadata jsonb not null default '{}'::jsonb,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (provider, provider_subscription_ref)
);
create index if not exists premium_subscriptions_user_idx on public.premium_subscriptions(user_id);
create index if not exists premium_subscriptions_status_idx on public.premium_subscriptions(status, current_period_end);

create table if not exists public.premium_webhook_events (
  id bigint generated by default as identity primary key,
  provider text not null,
  provider_event_ref text not null,
  event_type text not null,
  signature_verified boolean not null default false,
  occurred_at timestamptz,
  received_at timestamptz not null default now(),
  processed_at timestamptz,
  processing_status text not null default 'received' check (processing_status in ('received','processed','ignored','failed')),
  processing_attempts integer not null default 0 check (processing_attempts >= 0),
  last_error_code text,
  payload_digest text not null,
  payload_redacted jsonb,
  unique (provider, provider_event_ref)
);
create index if not exists premium_webhook_processing_idx on public.premium_webhook_events(processing_status, received_at);

create table if not exists public.premium_entitlements (
  user_id uuid primary key references auth.users(id) on delete cascade,
  entitlement_code text not null default 'premium_monthly',
  status text not null check (status in ('active','grace','inactive','revoked')),
  valid_from timestamptz,
  valid_until timestamptz,
  source_provider text,
  source_subscription_ref text,
  is_test boolean not null default true,
  updated_at timestamptz not null default now()
);
create index if not exists premium_entitlements_status_idx on public.premium_entitlements(status, valid_until);

create table if not exists public.premium_campaign_state (
  campaign_code text primary key,
  lifecycle_status text not null check (lifecycle_status in ('PRE_LAUNCH','LIVE','PAUSED','CLOSED','ARCHIVED')),
  entries_open boolean not null default false,
  kill_switch boolean not null default true,
  target_count integer not null check (target_count > 0),
  opens_at timestamptz,
  closes_at timestamptz,
  eligibility_cutoff_at timestamptz,
  rules_version text,
  updated_at timestamptz not null default now(),
  check (not entries_open or (lifecycle_status = 'LIVE' and kill_switch = false))
);

insert into public.premium_campaign_state(campaign_code,lifecycle_status,entries_open,kill_switch,target_count)
values ('premium_3000_iphone','PRE_LAUNCH',false,true,3000)
on conflict (campaign_code) do nothing;

create table if not exists public.premium_campaign_eligibility (
  campaign_code text not null references public.premium_campaign_state(campaign_code) on delete cascade,
  user_id uuid not null references auth.users(id) on delete cascade,
  technically_eligible boolean not null default false,
  exclusion_reason text,
  source_entitlement_updated_at timestamptz,
  evaluated_at timestamptz not null default now(),
  frozen_at timestamptz,
  primary key (campaign_code, user_id)
);
create index if not exists premium_campaign_eligible_idx on public.premium_campaign_eligibility(campaign_code, technically_eligible);

create table if not exists public.premium_campaign_audit_log (
  id bigint generated by default as identity primary key,
  campaign_code text not null,
  action text not null,
  actor_type text not null check (actor_type in ('system','admin','support','reconciliation')),
  actor_ref text,
  reason text,
  old_data jsonb,
  new_data jsonb,
  created_at timestamptz not null default now()
);
create index if not exists premium_campaign_audit_idx on public.premium_campaign_audit_log(campaign_code, created_at desc);

alter table public.premium_provider_customers enable row level security;
alter table public.premium_subscriptions enable row level security;
alter table public.premium_webhook_events enable row level security;
alter table public.premium_entitlements enable row level security;
alter table public.premium_campaign_state enable row level security;
alter table public.premium_campaign_eligibility enable row level security;
alter table public.premium_campaign_audit_log enable row level security;

revoke all on public.premium_provider_customers from anon, authenticated;
revoke all on public.premium_subscriptions from anon, authenticated;
revoke all on public.premium_webhook_events from anon, authenticated;
revoke all on public.premium_entitlements from anon, authenticated;
revoke all on public.premium_campaign_state from anon, authenticated;
revoke all on public.premium_campaign_eligibility from anon, authenticated;
revoke all on public.premium_campaign_audit_log from anon, authenticated;

create or replace function private.premium_campaign_eligible_count(p_campaign_code text)
returns bigint
language sql
security definer
set search_path = public, pg_temp
as $$
  select case
    when not exists (
      select 1 from public.premium_campaign_state s
      where s.campaign_code = p_campaign_code
        and s.lifecycle_status = 'LIVE'
        and s.entries_open = true
        and s.kill_switch = false
    ) then 0::bigint
    else (
      select count(*)::bigint
      from public.premium_campaign_eligibility e
      join public.premium_entitlements pe on pe.user_id = e.user_id
      where e.campaign_code = p_campaign_code
        and e.technically_eligible = true
        and e.frozen_at is null
        and pe.status in ('active','grace')
        and pe.is_test = false
        and (pe.valid_until is null or pe.valid_until > now())
    )
  end;
$$;

revoke all on function private.premium_campaign_eligible_count(text) from public, anon, authenticated;

-- DESIGN FILE ONLY: always roll back local scratch execution.
rollback;
